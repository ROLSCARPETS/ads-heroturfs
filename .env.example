# Meta Marketing API - credenciales
# NO commitear el .env real, solo este .example

META_ACCESS_TOKEN=your_long_lived_token_here
META_AD_ACCOUNT_ID=act_2287331294937474
META_API_VERSION=v21.0

# Configuracion de sincronizacion
SYNC_DAYS_BACK=90

# HubSpot CRM - credenciales (Private App Access Token)
# Crear en: HubSpot > Settings > Integrations > Private Apps
# Scopes minimos requeridos: crm.objects.contacts.read, crm.objects.deals.read,
#                            crm.objects.companies.read, crm.schemas.contacts.read,
#                            crm.schemas.deals.read
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google Ads API
# 1. Solicitar Developer Token desde MCC: https://ads.google.com/aw/apicenter
# 2. Crear OAuth Desktop app en Google Cloud Console y descargar JSON
# 3. Generar refresh token con: python _get_google_refresh_token.py
GOOGLE_DEVELOPER_TOKEN=AbCdEfGhIjKlMnOpQrStUv
GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Customer IDs SIN guiones
GOOGLE_LOGIN_CUSTOMER_ID=1234567890
GOOGLE_CUSTOMER_ID=0987654321

# OpenAI (chatbot del dashboard)
# Generar en https://platform.openai.com/api-keys (requiere saldo en la cuenta)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# === SSO con rols-bi portal (opcional) ===
# Si pones SECRET_KEY se activa el login compartido via cookie 'bi_session'
# firmada por el portal. Debe ser EL MISMO valor que en rols-bi/.env.
# Sin esto la app funciona sin login (solo dev local).
SECRET_KEY=
SESSION_COOKIE_NAME=bi_session
BI_PORTAL_URL=http://localhost:5000
SESSION_COOKIE_DOMAIN=
