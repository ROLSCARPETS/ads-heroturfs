# Meta Marketing API - credenciales
# NO commitear el .env real, solo este .example

META_ACCESS_TOKEN=your_long_lived_token_here
META_AD_ACCOUNT_ID=act_2287331294937474
META_API_VERSION=v21.0

# Configuracion de sincronizacion
SYNC_DAYS_BACK=90

# HubSpot CRM - credenciales (Private App Access Token)
# Crear en: HubSpot > Settings > Integrations > Private Apps
# Scopes minimos requeridos: crm.objects.contacts.read, crm.objects.deals.read,
#                            crm.objects.companies.read, crm.schemas.contacts.read,
#                            crm.schemas.deals.read
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
